#include "kernel_operator.h"
#include "acl/acl.h"
#include "config.h"
using namespace AscendC;
// Each AIC block computes one independent ND INT8 tile. No quantization.
// A: 16x32; B: 32x64; C: 16x64. Host supplies one pair per block.
extern "C" __global__ __aicore__ void exact_int8_tiles(GM_ADDR a, GM_ADDR b, GM_ADDR c) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    const uint32_t id = GetBlockIdx();
    GlobalTensor<int8_t> ga, gb;
    GlobalTensor<int32_t> gc;
    ga.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(a)+id*AS, AS);
    gb.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(b)+id*BS, BS);
    gc.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(c)+id*CS, CS);
    TPipe p;
    TQue<TPosition::A1,1> qa1;
    TQue<TPosition::B1,1> qb1;
    TQue<TPosition::A2,1> qa2;
    TQue<TPosition::B2,1> qb2;
    TQue<TPosition::CO1,1> qc;
    p.InitBuffer(qa1,1,AS); p.InitBuffer(qb1,1,BS);
    p.InitBuffer(qa2,1,AS); p.InitBuffer(qb2,2,BS);
    p.InitBuffer(qc,1,CS*sizeof(int32_t));
    auto a1=qa1.AllocTensor<int8_t>();
    auto b1=qb1.AllocTensor<int8_t>();
    Nd2NzParams moveA{};
    moveA.ndNum=1; moveA.nValue=TM; moveA.dValue=TK;
    moveA.srcDValue=TK; moveA.dstNzC0Stride=TM; moveA.dstNzNStride=1;
    Nd2NzParams moveB{};
    moveB.ndNum=1; moveB.nValue=TK; moveB.dValue=TN;
    moveB.srcDValue=TN; moveB.dstNzC0Stride=TK; moveB.dstNzNStride=1;
    DataCopy(a1,ga,moveA); DataCopy(b1,gb,moveB);
    qa1.EnQue(a1); qb1.EnQue(b1);
    a1=qa1.DeQue<int8_t>(); b1=qb1.DeQue<int8_t>();
    auto a2=qa2.AllocTensor<int8_t>(); auto b2=qb2.AllocTensor<int8_t>();
    LoadData2DParams la{};
    la.repeatTimes=AS/512; la.srcStride=1; la.ifTranspose=false;
    LoadData(a2,a1,la);
    // INT8 32x32 transpose groups; 2 groups for N=64.
    LoadData2dTransposeParams lb{};
    lb.repeatTimes=TN/32; lb.srcStride=1; lb.dstGap=1; lb.dstFracGap=0;
    LoadDataWithTranspose(b2,b1,lb);
    qa2.EnQue(a2); qb2.EnQue(b2);
    qa1.FreeTensor(a1); qb1.FreeTensor(b1);
    a2=qa2.DeQue<int8_t>(); b2=qb2.DeQue<int8_t>();
    auto c1=qc.AllocTensor<int32_t>();
    MmadParams mm{};
    mm.m=TM; mm.n=TN; mm.k=TK; mm.cmatrixInitVal=true; mm.cmatrixSource=false;
    Mmad(c1,a2,b2,mm);
    qc.EnQue(c1); qa2.FreeTensor(a2); qb2.FreeTensor(b2);
    c1=qc.DeQue<int32_t>();
    FixpipeParamsV220 fp{};
    fp.mSize=TM; fp.nSize=TN; fp.srcStride=TM; fp.dstStride=TN;
    fp.ndNum=1; fp.quantPre=QuantMode_t::NoQuant; fp.reluEn=false;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gc,c1,fp);
    qc.FreeTensor(c1);
    PipeBarrier<PIPE_ALL>();
}
extern "C" void launch_int8_tiles(void* a, void* b, void* c, uint32_t blocks, aclrtStream stream) {
    exact_int8_tiles<<<blocks,nullptr,stream>>>(static_cast<uint8_t*>(a),static_cast<uint8_t*>(b),static_cast<uint8_t*>(c));
}
